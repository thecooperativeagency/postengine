# PostEngine environment variable names. Values stay empty in git.
# Production boot refuses to start when a required name is missing.
# Optional names are logged and the process still starts.
# See docs/RAILWAY_DEPLOY.md.

# --- required in production ---
# Same 5-digit PIN managers type today. The login screen does not change.
ENGINE_DASHBOARD_PASSWORD=
CRON_SECRET=
ZERNIO_API_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=
# One of these two. JSON text, or a file path. Do not commit folder ids.
DRIVE_FOLDERS_JSON=
DRIVE_FOLDERS_PATH=

# --- optional (missing values are logged; process still starts) ---
# Telegram is dropped. Unset token or chat id: notifications no-op, webhook 404, no setWebhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_SET_WEBHOOK=
# Captions fail soft without CAPTION_API_KEY.
# Generic caption key. Replaces NOUS_API_KEY, ANTHROPIC_API_KEY, and GITHUB_MODELS_TOKEN.
CAPTION_API_KEY=
# Default nous. Also: openai, openai-compatible, github-models, fallback.
CAPTION_PROVIDER=
# Used when CAPTION_PROVIDER=openai-compatible. Nous has a fixed endpoint.
CAPTION_BASE_URL=
# Default anthropic/claude-haiku-4.5
CAPTION_MODEL=
# GitHub upload is off unless this is 1. Token is only for the one-time raw-URL migration.
GITHUB_TOKEN=
GITHUB_MEDIA_UPLOAD=
# Reels music. Not used unless a reel render runs.
# Optional path for Harris Porsche monthly sales HTML. Unset skips that source.
PORSCHE_SALES_EMAIL_DIR=
EPIDEMIC_SOUND_API_KEY=
# One-time Mac import. Unset rejects POST /api/admin/import.
IMPORT_TOKEN=
# Exactly true enables the 60s publish loop and the weekly Drive scan. Default off.
PUBLISH_ENABLED=

# Optional origin for new /media/generated URLs. Unset keeps https://postengine.thecoopbrla.com.
PUBLIC_APP_URL=

# --- runtime paths (Railway sets these in .railway/railway.ts) ---
PORT=
NODE_ENV=
SQLITE_PATH=
MEDIA_DIR=
MEDIA_GENERATED_DIR=
FFMPEG_PATH=
FFPROBE_PATH=
ZERNIO_ACCOUNTS_PATH=
POSTENGINE_URL=
POSTENGINE_HOST=
POSTENGINE_PORT=
POSTENGINE_SCHEME=

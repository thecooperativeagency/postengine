# PostEngine environment variable names. Values stay empty in git.
# Production boot refuses to start when a required name is missing.
# Optional names are logged and the process still starts.
# See docs/RAILWAY_DEPLOY.md.

# --- required in production ---
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
CRON_SECRET=
ZERNIO_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
PUBLIC_APP_URL=
GOOGLE_SERVICE_ACCOUNT_JSON=
# One of these two. JSON text, or a file path. Do not commit folder ids.
DRIVE_FOLDERS_JSON=
DRIVE_FOLDERS_PATH=

# --- optional (live Mini .env names included) ---
# Caption provider. Default anthropic. Fail-soft template if the call fails.
ANTHROPIC_API_KEY=
CAPTION_PROVIDER=
CAPTION_BASE_URL=
CAPTION_MODEL=
GITHUB_MODELS_TOKEN=
# GitHub upload is off unless this is 1. Token is only for the one-time raw-URL migration.
GITHUB_TOKEN=
GITHUB_MEDIA_UPLOAD=
# Live Mini dashboard gate. This branch uses BASIC_AUTH until the Mini snapshot is reviewed.
ENGINE_DASHBOARD_PASSWORD=
# Reels music. Not used by this branch's publisher.
EPIDEMIC_SOUND_API_KEY=
TELEGRAM_SET_WEBHOOK=

# --- runtime paths (Railway sets these in .railway/railway.ts) ---
PORT=
NODE_ENV=
SQLITE_PATH=
MEDIA_DIR=
MEDIA_GENERATED_DIR=
FFMPEG_PATH=
FFPROBE_PATH=
ZERNIO_ACCOUNTS_PATH=
POSTENGINE_URL=
POSTENGINE_HOST=
POSTENGINE_PORT=
POSTENGINE_SCHEME=
